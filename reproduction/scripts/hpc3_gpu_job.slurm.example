#!/bin/bash
# UCI HPC3 GPU 作业模板(示例)
# 用法: sbatch hpc3_gpu_job.slurm.example
# ⚠️ 分区名 / GRES 写法以 RCIC 文档为准,先用 `sinfo` 看可用分区,`module avail` 看可用模块。

#SBATCH --job-name=vla-test
#SBATCH --partition=free-gpu          # 免费 GPU 队列(可能被抢占);有分配后可换 gpu 队列
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:A30:1              # 申请 1 张 A30(24GB);π0 全量微调改 A100
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x-%j.out       # 先 mkdir -p logs

set -e
module load anaconda/2022.05 || module load miniconda3   # 模块名以 `module avail` 为准
source activate openvla

# 自检:确认拿到 GPU
python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))
PY

# 在这里放你的推理 / 评测命令,例如:
# python experiments/robot/libero/run_libero_eval.py \
#   --model_family openvla \
#   --pretrained_checkpoint openvla/openvla-7b-finetuned-libero-spatial \
#   --task_suite_name libero_spatial
